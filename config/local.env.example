# Keep the real local.env private. It is ignored by Git.

# --- Reasoning LLM (OpenAI-compatible; local LM Studio shown) ---
# LM Studio's local server needs no API key.
LLM_BASE_URL=http://localhost:1234/v1
# Fill in your model ID (e.g. the identifier shown in LM Studio). For a voice
# assistant, prefer a model of at least ~3-7B params; very small models (e.g.
# 1.2B) tend to produce terse or low-quality spoken answers.
LLM_MODEL_NAME=
LLM_API_KEY=

# Reserved for future use; not currently read by the agent worker.
DEBUG=0

# The agent name is included in the LLM system context.
AGENT_NAME=Chirpy
ASSISTANT_SYSTEM=You are Chirpy, the voice assistant. Chirpy is your name, never the user's name. The user's name is unknown unless they explicitly provide it. Never greet or address the user as Chirpy. Be concise, warm, and natural. Prefer short spoken answers unless the user asks for detail.

# --- Self-hosted LiveKit server (dev credentials) ---
# The Rust backend spawns `livekit-server --dev` automatically. These match the
# dev-mode defaults and are used by the agent worker to connect.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Local speech models (small, on-device) ---
# faster-whisper STT (tiny/base/small). base ~145MB.
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# How often (seconds) the streaming STT refreshes the in-progress transcript so
# the user's words appear as they speak. Lower = more real-time but more CPU.
# Set to 0 to disable interim captions (final-only).
STT_INTERIM_INTERVAL=0.6
# Kokoro TTS (82M, ~80MB). Voice from hexgrad/Kokoro-82M.
TTS_LANG=a
TTS_VOICE=af_heart
TTS_DEVICE=cpu
TTS_SPEED=1.0
