# Keep the real local.env private. It is ignored by Git.

# --- Reasoning LLM (OpenAI-compatible; local LM Studio shown) ---
# LM Studio's local server needs no API key.
LLM_BASE_URL=http://localhost:1234/v1
# Fill in your model ID (e.g. the identifier shown in LM Studio). For a voice
# assistant, prefer a model of at least ~3-7B params; very small models (e.g.
# 1.2B) tend to produce terse or low-quality spoken answers.
LLM_MODEL_NAME=
LLM_API_KEY=

# Reserved for future use; not currently read by the agent worker.
DEBUG=0

# The agent name is included in the LLM system context.
AGENT_NAME=Chirpy
# Full barge-in is enabled by default: the user can interrupt the assistant
# mid-speech. If left unset, a natural spoken persona prompt is used.
ASSISTANT_SYSTEM=You are Chirpy, the voice assistant. Chirpy is your name, never the user's name. The user's name is unknown unless they explicitly provide it. Never greet or address the user as Chirpy. Be concise, warm, and natural. Prefer short spoken answers unless the user asks for detail.

# --- Barge-in (user interrupts the assistant mid-speech) ---
# Barge-in is ON by default. Set to false to disable interruptions.
BARGE_IN=true
# Interruption strategy. "vad" (default) uses the local Silero VAD and works
# fully offline/self-hosted. "adaptive" uses LiveKit's cloud interruption
# service and requires hosted API credentials; it auto-falls back to "vad" when
# no hosted credentials are present.
INTERRUPTION_MODE=vad
# These barge-in knobs default to LiveKit's own natural interruption policy when
# left unset (you can delete them). They are data-driven, not hardcoded, and can
# be overridden live at runtime via config/barge-in.json.
# Minimum sustained speech (s) before an interruption counts. LiveKit default 0.5.
BARGE_IN_MIN_DURATION=0.5
# Minimum transcribed words before a barge-in counts (0 = any speech activity).
# LiveKit default 0.
BARGE_IN_MIN_WORDS=0
# Seconds of silence after an interruption before it is treated as a false
# start and the assistant resumes speaking. Set to off/0 to disable resume.
# LiveKit default 2.0.
BARGE_IN_FALSE_TIMEOUT=2.0
# Suppress interruptions near the start/end of an agent turn (backchannels,
# echo onset). Values: auto/1 (default), off/0, or "start,end" in seconds.
BARGE_IN_BACKCHANNEL=auto
# Resume the reply after a false interruption.
BARGE_IN_RESUME_FALSE=true
# Seconds after session start to keep interruptions disabled while acoustic echo
# cancellation converges (prevents the agent interrupting itself on its own
# first words). 0 disables the warm-up window.
AEC_WARMUP_DURATION=3.0
# Echo-guard: at/above this token-overlap ratio between a "user" transcript and
# the agent's own recent speech, the input is treated as speaker echo and never
# becomes a user turn. Content-based (not a word/time count). 0..1, default 0.6.
ECHO_OVERLAP_THRESHOLD=0.6

# --- Natural turn-taking ---
# End-of-turn delay bounds (seconds) before the agent replies once you stop
# speaking. Larger = more patient, smaller = snappier.
ENDPOINTING_MIN_DELAY=0.7
ENDPOINTING_MAX_DELAY=2.0

# --- Voice Activity Detection (roomkit-style pluggable VAD) ---
# VAD_MODEL points at a sherpa-onnx .onnx (TEN-VAD) downloaded by scripts/setup.sh
# into engine/chirpy/.models/; if it's missing the worker falls back to the
# zero-dependency energy (RMS) VAD.
VAD_MODEL=.models/ten-vad.onnx
# VAD_MODEL_TYPE=ten        # "ten" (TEN-VAD) or "silero"
# VAD_THRESHOLD=0.35        # speech prob threshold; 0.5 without a denoiser
# VAD_SILENCE_MS=500        # silence before end-of-speech (raise 600-800 if cut off)
# VAD_MIN_SPEECH_MS=250     # minimum speech segment length
# VAD_SPEECH_PAD_MS=300     # pre-roll padding so onsets aren't clipped
# VAD_ENERGY_SILENCE_RMS=0.0006  # energy fast-exit gate (float scale; 0 disables)
# VAD_ENERGY_THRESHOLD=0.01       # energy VAD RMS threshold (float scale)
# VAD_SAMPLE_RATE=16000

# --- Self-hosted LiveKit server (dev credentials) ---
# The Rust backend spawns `livekit-server --dev` automatically. These match the
# dev-mode defaults and are used by the agent worker to connect.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Local speech models (small, on-device) ---
# faster-whisper STT. The default 'tiny' is the lightest (~39MB); switch to
# 'base' (~145MB) for better accuracy at the cost of size/speed.
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# How often (seconds) the streaming STT refreshes the in-progress transcript so
# the user's words appear as they speak. Lower = more real-time but more CPU.
# Set to 0 to disable interim captions (final-only).
STT_INTERIM_INTERVAL=0.6
# Kokoro TTS (82M, ~80MB). Voice from hexgrad/Kokoro-82M.
TTS_LANG=a
TTS_VOICE=af_heart
TTS_DEVICE=cpu
TTS_SPEED=1.0
