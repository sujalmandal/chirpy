# Keep the real local.env private. It is ignored by Git.

# --- Reasoning LLM (OpenAI-compatible; local LM Studio shown) ---
# LM Studio's local server needs no API key.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=liquid/lfm2.5-1.2b
LLM_API_KEY=

# The agent name is included in the LLM system context.
AGENT_NAME=Nova
ASSISTANT_SYSTEM=Your name is Nova. Be concise, warm, and natural. Prefer short spoken answers unless the user asks for detail.

# --- Local Kyutai speech models (all on-device MLX) ---
# STT 1B with built-in semantic VAD (English + French, ~2.4 GB).
STT_REPO=kyutai/stt-1b-en_fr-candle
# Force a full streaming-state rotation before the model's fixed positional
# context fills. 3000 blocks is roughly four minutes at 80 ms per block.
STT_ROTATE_BLOCKS=3000
# The current VAD adapter uses the semantic head embedded in the Kyutai STT
# checkpoint, plus these energy/timing safeguards.
VAD_REPO=kyutai/stt-1b-en_fr-candle
VAD_THRESHOLD=0.01
VAD_SEMANTIC_THRESHOLD=0.6
# Hysteresis and stability controls for the STT model's semantic pause head.
VAD_SEMANTIC_SPEECH_THRESHOLD=0.4
VAD_SEMANTIC_HOLD_BLOCKS=3
# A semantic pause must also include this much measured silence.
VAD_SEMANTIC_SILENCE_MS=320
# Ignore the semantic head's unstable first ~960 ms after a model reset.
VAD_WARMUP_BLOCKS=12
# The energy fallback adapts upward to the measured room noise floor.
VAD_NOISE_MULTIPLIER=3.0
VAD_MIN_SPEECH_MS=320
VAD_MIN_SILENCE_MS=800
# Kyutai TTS 1.6B streaming model (~4 GB). Needs GPU; on Mac use TTS_QUANTIZE.
TTS_REPO=kyutai/tts-1.6b-en_fr
TTS_VOICE_REPO=kyutai/tts-voices
# A voice from the tts-voices repo (see https://huggingface.co/kyutai/tts-voices).
TTS_VOICE=expresso/ex03-ex01_happy_001_channel1_334s.wav
# 0 = none, 4 or 8 = int4/int8 quantization (faster, needed on-device).
TTS_QUANTIZE=8

# --- Local agent ports ---
AGENT_PORT=8999
