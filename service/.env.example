# All paths and models stay on this machine.
WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin

# Any local server exposing POST /v1/chat/completions with SSE streaming.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:14b
ASSISTANT_SYSTEM="You are a concise, helpful local voice assistant. Reply naturally in short spoken sentences."

PIPER_BIN=/absolute/path/to/piper
PIPER_MODEL=/absolute/path/to/en_US-lessac-medium.onnx
